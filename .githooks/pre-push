#!/usr/bin/env bash
# Reject pushes that still contain Cursor agent attribution in commit messages.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=check-cursor-trailers.sh
source "$root/.githooks/check-cursor-trailers.sh"

zero="0000000000000000000000000000000000000000"
failed=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[[ -n "${local_sha:-}" ]] || continue

	# Branch deleted locally — nothing to scan.
	if [[ "$local_sha" == "$zero" ]]; then
		continue
	fi

	if [[ "$remote_sha" == "$zero" ]]; then
		# New ref: scan commits not already on any remote-tracking branch.
		range="$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)"
	else
		range="$(git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true)"
	fi

	[[ -n "$range" ]] || continue

	while IFS= read -r commit; do
		[[ -n "$commit" ]] || continue
		if commit_has_cursor_trailer "$commit"; then
			echo "error: commit ${commit:0:12} contains Cursor co-author attribution:" >&2
			git log -1 --format='  %s%n%b' "$commit" | grep -iE 'cursoragent@cursor\.com|^[[:space:]]*Co-authored-by:[[:space:]]*Cursor\b' >&2 || true
			echo "  Amend or rebase to remove it, then push again." >&2
			failed=1
		fi
	done <<<"$range"
done

if [[ "$failed" -ne 0 ]]; then
	exit 1
fi

exit 0
